# ─────────────────────────────────────────────────────────────────────────────
# GreenTrustLens backend — environment template
#
# Copy to .env for local development:  cp .env.example .env
# On Northflank, add these as the service's environment variables.
# Values marked (required) abort startup if missing.
# ─────────────────────────────────────────────────────────────────────────────

# ─── RUNTIME ─────────────────────────────────────────────────────────────────
NODE_ENV=production
# Northflank injects PORT automatically — only set this locally.
PORT=3000
HOST=0.0.0.0

# ─── DATABASE (required) ─────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# ─── GROQ LLM (required) ─────────────────────────────────────────────────────
GROQ_API_KEY=""
# Any chat-completion model available on your Groq account. Check
# https://console.groq.com/docs/models for the current list.
GROQ_MODEL="openai/gpt-oss-120b"

# ─── HTTP ────────────────────────────────────────────────────────────────────
# "*" allows any origin. Prefer an explicit frontend URL in production, or a
# comma-separated list: https://app.example.com,https://www.example.com
CORS_ORIGIN=*
JSON_BODY_LIMIT=10mb

# ─── UPLOADS ─────────────────────────────────────────────────────────────────
# Mount a Northflank volume at this path, otherwise uploaded files are lost
# on every redeploy.
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_MB=20

# ─── URL SCRAPING ────────────────────────────────────────────────────────────
SCRAPE_TIMEOUT_MS=15000
SCRAPE_USER_AGENT="Mozilla/5.0 (compatible; GreenTrustLens/1.0; +https://greentrustlens.com/bot)"
