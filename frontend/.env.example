# ─────────────────────────────────────────────────────────────────────────────
# GreenTrustLens frontend — environment template
#
# Copy to .env.local for local development:  cp .env.example .env.local
# On Vercel, add NEXT_PUBLIC_API_URL under Project → Settings → Environment
# Variables (Production, Preview and Development).
# ─────────────────────────────────────────────────────────────────────────────

# Base URL of the backend API (no trailing slash).
# Local:      http://localhost:3000
# Production: https://<your-backend>.northflank.app
NEXT_PUBLIC_API_URL=http://localhost:3000
